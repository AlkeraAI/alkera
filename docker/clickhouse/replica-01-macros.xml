<clickhouse>
    <macros>
        <cluster>alkera_ha_cluster</cluster>
        <shard>01</shard>
        <replica>clickhouse-01</replica>
    </macros>
    <zookeeper>
        <node>
            <host>clickhouse-keeper</host>
            <port>9181</port>
        </node>
    </zookeeper>
    <remote_servers>
        <alkera_ha_cluster>
            <shard>
                <internal_replication>true</internal_replication>
                <replica>
                    <host>clickhouse-01</host>
                    <port>9000</port>
                </replica>
                <replica>
                    <host>clickhouse-02</host>
                    <port>9000</port>
                </replica>
            </shard>
        </alkera_ha_cluster>
    </remote_servers>
    <storage_configuration>
        <disks>
            <s3_cold_disk>
                <type>s3</type>
                <endpoint>http://localstack:4566/alkera-clickhouse-cold/data/</endpoint>
                <access_key_id>test</access_key_id>
                <secret_access_key>test</secret_access_key>
                <region>us-east-2</region>
            </s3_cold_disk>
        </disks>
        <policies>
            <s3_tiered_policy>
                <volumes>
                    <hot_nvme>
                        <disk>default</disk>
                    </hot_nvme>
                    <s3_cold>
                        <disk>s3_cold_disk</disk>
                    </s3_cold>
                </volumes>
            </s3_tiered_policy>
        </policies>
    </storage_configuration>
</clickhouse>
